CCFRP_dataset %>%
group_by(Year) %>%
summarise(
n_obs = n(),
total_catch = sum(Count, na.rm = TRUE),
mean_catch = mean(Count, na.rm = TRUE),
max_catch = max(Count, na.rm = TRUE),
min_catch = min(Count, na.rm = TRUE),
mean_CPUE = mean(CPUE_catch_per_angler_hour, na.rm = TRUE),
max_CPUE = max(CPUE_catch_per_angler_hour, na.rm = TRUE)
)
